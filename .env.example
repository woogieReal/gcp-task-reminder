# 복사해서 .env로 사용한다 (.env는 Git에 커밋되지 않음). 절차는 README.md 참고.
PORT=8080
NODE_ENV=development

GCP_PROJECT_ID=woogie-sandbox-gcp
GCP_LOCATION=asia-northeast3
GCP_QUEUE_NAME=reminder-queue
# 태스크가 호출할 대상이므로 로컬 주소가 아닌 Cloud Run URL
SERVICE_URL=https://reminder-api-371125433847.asia-northeast3.run.app
TASKS_INVOKER_SA_EMAIL=reminder-tasks-invoker@woogie-sandbox-gcp.iam.gserviceaccount.com

# Secret Manager에서 조회해 채운다
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=8509618162

GOOGLE_OAUTH_CLIENT_ID=371125433847-4kg70jj2tbj5p640mpn0qfee884c0mbm.apps.googleusercontent.com
ALLOWED_EMAIL=woogiereal@gmail.com
# 로컬 전용 임의 문자열 (openssl rand -hex 32)
SESSION_SECRET=<random-local-secret>

# 로컬에서 /trigger를 curl로 직접 호출하기 위한 옵션 (NODE_ENV=development에서만 동작)
SKIP_TRIGGER_AUTH=true
